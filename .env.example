# Комментарии — только отдельной строкой: docker compose считает «# …» после значения частью значения.

# ── MAX Bot API (https://dev.max.ru). Без токена работает демо-чат в панели HR.
MAX_TOKEN=
# Никнейм бота: из него строится QR/диплинк https://max.ru/<bot>?start=<код>
MAX_BOT_NAME=
# https://<домен>/max/webhook; пусто — long polling (только для разработки)
MAX_WEBHOOK_URL=
# Обязателен для вебхука: запросы без секрета не принимаются.
MAX_WEBHOOK_SECRET=
# id группового чата HR, куда бот публикует эскалации (бот — админ чата)
MAX_HR_CHAT_ID=
# Набор доверенных сертификатов для platform-api2.max.ru: публичные корневые + Минцифры (см. README)
MAX_CA_BUNDLE=
# Демо-доступ «попробуйте сами»: QR на https://max.ru/<бот>?start=<это значение>. Пусто — выключено (прод)
DEMO_TRY_PAYLOAD=

# ── LLM: любой OpenAI-совместимый endpoint. По умолчанию — локальная GigaChat 3.1 Lightning
# (docker compose --profile local-llm). Переопределяйте, только если LLM внешняя:
# LLM_BASE_URL=http://localhost:8081/v1
# LLM_MODEL=gigachat-3.1-lightning
# LLM_API_KEY=local
# Yandex AI Studio:  LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1  LLM_MODEL=gpt://<folder>/yandexgpt/latest  LLM_API_KEY=<api-key>
# Если провайдер не поддерживает response_format=json_schema:
# LLM_JSON_SCHEMA=false

# Пусто — панель без пароля (только для локального демо)
ADMIN_TOKEN=
# Ключ API кадровой системы (1С и подобных): POST /api/hr-system/employees, заголовок Authorization: Bearer <ключ>.
# Пусто — API выключен. Задайте длинную случайную строку, отдельную от ADMIN_TOKEN, например: openssl rand -hex 24
HR_API_KEY=
PUBLIC_BASE_URL=http://localhost:8000
